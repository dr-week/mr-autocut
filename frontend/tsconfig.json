{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "paths": {
      "@zuari/signals": ["./vendor/fast-framework/packages/signals/src/index.ts"],
      "@zuari/tokens": ["./vendor/fast-framework/packages/tokens/src/index.ts"],
      "@zuari/presets": ["./vendor/fast-framework/packages/presets/src/index.ts"],
      "@zuari/glyphs": ["./vendor/fast-framework/packages/glyphs/src/index.ts"]
    }
  },
  "include": ["src"]
}
